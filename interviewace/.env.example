# InterviewAce environment configuration
# Copy this file to ".env" and fill in your own values. Never commit the result.

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------
# Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
# The google-genai SDK reads GOOGLE_API_KEY; use that name, not GEMINI_API_KEY.
GOOGLE_API_KEY="your-gemini-api-key-here"

# ---------------------------------------------------------------------------
# STRONGLY RECOMMENDED IN PRODUCTION
# ---------------------------------------------------------------------------
# Signs the session tokens that authorize analytics reads. If unset, each instance
# generates its own ephemeral secret, so tokens stop validating across restarts or
# across instances. Generate one with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=""

# ---------------------------------------------------------------------------
# OPTIONAL - model selection
# ---------------------------------------------------------------------------
# Live API model for the voice interview. Leave unset to use the built-in default
# (gemini-2.5-flash-native-audio-preview-12-2025).
# AGENT_MODEL="gemini-2.5-flash-native-audio-preview-12-2025"

# Standard text model used by the search-grounding sub-agent.
# SEARCH_MODEL="gemini-2.5-flash"

# Set to TRUE to route through Vertex AI instead of the AI Studio API key.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Set to "false" to drop the google_search grounding sub-agent entirely.
ENABLE_SEARCH_GROUNDING="true"

# ---------------------------------------------------------------------------
# OPTIONAL - quota and abuse guardrails
# ---------------------------------------------------------------------------
# Defaults are tuned for the Gemini API FREE TIER, where Live API concurrency is very
# small. Admitting more sessions than the quota allows does not serve more people; it
# makes all of them fail mid-interview with a 429. Raise these on a paid quota.
#
# If you attach a billing account, these caps become cost controls too - add a GCP
# billing budget alert as well.
MAX_CONCURRENT_SESSIONS=2
MAX_SESSIONS_PER_IP=1
MAX_SESSION_SECONDS=600
NEW_SESSIONS_PER_IP_PER_HOUR=10
SILENCE_NUDGE_SECONDS=12

# ---------------------------------------------------------------------------
# OPTIONAL - diagnostics
# ---------------------------------------------------------------------------
# Exposes GET /debug. Leave unset in production; it returns runtime configuration.
# ENABLE_DEBUG_ENDPOINT="false"

# Port for the local server (Cloud Run sets this automatically).
PORT=8080
